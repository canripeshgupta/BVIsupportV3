# Serving rules for the BVI Support static site.
#
# Pages now live as real directories (/services/index.html, …), so Apache and
# LiteSpeed serve the clean URLs natively — DirectoryIndex + DirectorySlash do
# the work and no rewrite is needed for them. What is left here is the 404
# behaviour and 301s from the URLs the site used before this layout.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 0. Repo housekeeping files are not part of the website ---
  RewriteRule \.(md|json)$ - [R=404,L]

  # --- 1. Legacy *.dc.html URLs (the pre-2026-09-09 layout) -> clean paths ---
  RewriteCond %{THE_REQUEST} \s/+Home\.dc\.html[\s/?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Services\.dc\.html[\s/?] [NC]
  RewriteRule ^ /services/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Pricing\.dc\.html[\s/?] [NC]
  RewriteRule ^ /pricing/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+About\.dc\.html[\s/?] [NC]
  RewriteRule ^ /about/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Contact\.dc\.html[\s/?] [NC]
  RewriteRule ^ /contact/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Legal\.dc\.html[\s/?] [NC]
  RewriteRule ^ /legal/ [R=301,L]

  # --- 2. Extensionless URLs from the previous layout -> trailing-slash form ---
  # (DirectorySlash would already do this, but only with MultiViews-style
  #  guessing disabled it is worth being explicit and keeping it a 301.)
  RewriteRule ^(services|pricing|about|contact|legal)$ /$1/ [R=301,L]

  # --- 3. /index.html -> / ---
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # --- 4. Anything that is not a real file or directory -> hard 404 ---
  # Hostinger/LiteSpeed otherwise answers missing paths with a generic
  # "503 Service Unavailable".
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>
